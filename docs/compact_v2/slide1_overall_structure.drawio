<mxfile host="app.diagrams.net" type="device">
  <diagram name="Slide1-Overall-Structure" id="s1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="JAMEL-COMPACT: One LLM = Compressor + Actor" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="334" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Inputs -->
        <mxCell id="in_inst" value="Instruction" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="in_obs" value="Screenshot $O_t$" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="in_act" value="Prev. action $a_{t-1}$" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ctx_badge" value="Context = O(1)&#10;(instruction + current obs only)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- LLM stack -->
        <mxCell id="llm" value="Qwen3-VL Decoder (L layers)" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="260" height="330" as="geometry" />
        </mxCell>
        <mxCell id="layer1" value="Decoder Layer 1" style="rounded=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="layer2" value="Decoder Layer l" style="rounded=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="layerdots" value="..." style="text;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="300" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="layerL" value="Decoder Layer L" style="rounded=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Side memory unit (per layer) -->
        <mxCell id="mem" value="Side Memory $(M_l, P_l)$" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="mem_predict" value="1. Predict (FiLM-GRU)&#10;$\\hat M, \\hat P$" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="185" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="mem_correct" value="2. Correct (Kalman)&#10;$K=\\hat P/(\\hat P+R)$" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="245" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="mem_inject" value="3. Inject (zero-init gate)&#10;$W_\\uparrow=0$ at init" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="305" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- Output -->
        <mxCell id="out_act" value="Action $a_t$" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="520" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lmhead" value="LM Head" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="460" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Edges: inputs to LLM -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in_inst" target="layer1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in_obs" target="layer2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in_act" target="layerL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: LLM <-> memory (write/read) -->
        <mxCell id="e_write" value="write: observe $Z_t$" style="edgeStyle=orthogonalEdgeStyle;curved=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;fontSize=12;" edge="1" parent="1" source="layer2" target="mem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_read" value="read: inject" style="edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;fontSize=12;" edge="1" parent="1" source="mem" target="layer2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_actmem" value="$a_{t-1}$ (control)" style="edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.85;fontSize=12;" edge="1" parent="1" source="in_act" target="mem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Memory carried across steps -->
        <mxCell id="e_carry" value="$(M_t, P_t)$ carried across steps" style="edgeStyle=orthogonalEdgeStyle;curved=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;dashed=1;fontSize=12;fontStyle=2;" edge="1" parent="1" source="mem" target="mem">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="80" as="targetPoint" />
            <Array as="points">
              <mxPoint x="700" y="80" />
              <mxPoint x="860" y="80" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- LLM -> head -> action -->
        <mxCell id="e_head" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="llm" target="lmhead">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_out" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lmhead" target="out_act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Zero-init note -->
        <mxCell id="note_zeroinit" value="Zero-init injection: step 0 = pretrained LLM" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="440" width="260" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
